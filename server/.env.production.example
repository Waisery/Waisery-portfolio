NODE_ENV=production
DEMO_MODE=false
PORT=4000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=waisery_portfolio
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CLIENT_ORIGIN=https://YOUR-VERCEL-DOMAIN.vercel.app
# Optional resolver override for environments with restricted SRV DNS resolution.
DNS_SERVERS=
# Only needed for the one-time npm run seed command.
ADMIN_USERNAME=Waisery
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS
SEED_SAMPLE_CONTENT=false

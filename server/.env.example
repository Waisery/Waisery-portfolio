NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Paste an Atlas application connection string here to use your own database.
MONGODB_URI=
MONGODB_DB_NAME=waisery
DNS_SERVERS=
# Generate a unique value for production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Local only. Uses a real MongoDB process and persists files in server/.data/.
DEMO_MODE=true
# Production bootstrap: set all three, run npm run seed, then remove the password.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
